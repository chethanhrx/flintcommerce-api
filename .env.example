# Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Database
DB_DRIVER=sqlite
DB_DATABASE=storage/app.sqlite
# For MySQL/PostgreSQL:
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=woocommerce
# DB_USERNAME=root
# DB_PASSWORD=secret

# Security
AUTH_REQUIRE_HTTPS=true
RATE_LIMIT_MAX_ATTEMPTS=240
RATE_LIMIT_WINDOW_SECONDS=60
JWT_SECRET=your-32-character-minimum-secret-here-change-me
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# WooCommerce
WC_PRICE_DECIMALS=2
WC_CURRENCY=USD

# Tax
TAX_DECIMALS=2
TAX_ROUNDING_MODE=line
TAX_PRICES_INCLUDE_TAX=false

# Webhooks
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BASE_DELAY_MS=1000
WEBHOOK_MAX_DELAY_MS=300000
WEBHOOK_TIMEOUT_MS=10000