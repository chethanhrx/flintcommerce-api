{
    "name": "flintcommerce/api",
    "description": "A high-performance, WooCommerce v3-compatible REST API built on the FlintPHP framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^7.2",
        "flintphp/framework": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.11",
        "phpstan/phpstan-phpunit": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Tests\\": "tests/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true
    },
    "repositories": {
    }
}
